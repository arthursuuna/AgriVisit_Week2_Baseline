# AgriVisit Week 2 baseline — Google AI (Gemini)
#
# PUT YOUR KEY ON THE GOOGLE_API_KEY LINE BELOW.
# Get one from https://aistudio.google.com/apikey  (Create API key)
#
# This file must never be committed. Confirm `.env` is in .gitignore.
# When these files are dropped into a Laravel app, copy the block below into
# that app's own .env, then run:  php artisan config:clear

LLM_PROVIDER=google
LLM_MODEL=gemini-3.5-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4000
LLM_TIMEOUT=25
PROMPT_VERSION=v1.1

# Gemini 3 always reasons; thinking tokens are spent from LLM_MAX_TOKENS
# before any answer is written. minimal | low | medium | high
GOOGLE_THINKING_LEVEL=low

GOOGLE_API_KEY=

# Week 5: Claude runs the bounded agent loop only. Everything above stays on
# Gemini: drafting, the Week 4 tool console, and embeddings (the corpus vectors
# were built with gemini-embedding-001). See prompts/week5-claude-and-gemini.md.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_WORKSPACE_ID=            # only if the API asks for it
# ANTHROPIC_SEND_TEMPERATURE=false   # Sonnet 5.5 rejects a non-default temperature
# ANTHROPIC_EFFORT=medium            # low | medium | high | xhigh | max
# ANTHROPIC_THINKING_DISPLAY=updates # step plans between tool calls; empty disables
# Empty. A fallback model answering inside the same call would make the trace
# name a model that did not produce the reply.
ANTHROPIC_FALLBACKS=

# Week 5 bounded agent loop
# AGENT_MAX_ITERATIONS=6
# AGENT_MAX_FAILURES=3
# AGENT_MAX_RUNTIME=120
AGENT_PROMPT_VERSION=v1.0

# Alternative providers — leave blank unless you switch LLM_PROVIDER.
# OPENAI_API_KEY=
